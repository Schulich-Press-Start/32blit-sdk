cmake_minimum_required(VERSION 3.21)

file(REAL_PATH "${project_root}" project_root)
if(IS_SYMLINK "${destination}")
    message(FATAL_ERROR "Refusing to stage into a symlink: ${destination}")
endif()
file(MAKE_DIRECTORY "${destination}")
file(REAL_PATH "${destination}" destination)
cmake_path(IS_PREFIX destination "${project_root}" NORMALIZE overwrites_source)
if(overwrites_source)
    message(FATAL_ERROR "The scene-data destination must not contain the source project: ${destination}")
endif()
file(READ "${project_root}/blit-project.json" manifest)
string(JSON registry ERROR_VARIABLE no_registry GET "${manifest}" registry)

# Keep the editor's conventional assets/ and scenes/ trees in their entirety.
# The editor also allows PNGs and descriptors anywhere within the project.
# Do not recurse into build outputs (or another game/editor export).
function(collect_scene_entries directory output)
    set(entries)
    file(GLOB children RELATIVE "${project_root}" "${directory}/*")
    foreach(relative IN LISTS children)
        set(path "${project_root}/${relative}")
        get_filename_component(name "${path}" NAME)
        if(name MATCHES "^\\." OR IS_SYMLINK "${path}")
            continue()
        endif()
        if(IS_DIRECTORY "${path}")
            if(path STREQUAL destination OR EXISTS "${path}/CMakeCache.txt" OR EXISTS "${path}/blit-project.json" OR
               name MATCHES "^(build($|-)|cmake-build-|CMakeFiles$|_deps$|__pycache__$)")
                continue()
            endif()
            collect_scene_entries("${path}" descendants)
            if(descendants)
                list(APPEND entries "${relative}" ${descendants})
            endif()
        else()
            string(TOLOWER "${relative}" lower)
            if(relative STREQUAL "blit-project.json" OR relative STREQUAL "registry.json" OR relative STREQUAL registry OR
               lower MATCHES "^(assets|scenes)/|\\.(png|wav|font|scene|map|map\\.json|tileset\\.json|sprite\\.json|ui\\.json|audio\\.json|vfx\\.json)$")
                list(APPEND entries "${relative}")
            endif()
        endif()
    endforeach()
    set(${output} "${entries}" PARENT_SCOPE)
endfunction()

collect_scene_entries("${project_root}" current)
# Only prune paths written by the previous deployment, not arbitrary files a
# developer may already have below an install prefix.
set(inventory "${destination}/.blit-scene-files")
if(IS_SYMLINK "${inventory}")
    message(FATAL_ERROR "Invalid scene data inventory: ${inventory}")
endif()
if(EXISTS "${inventory}")
    file(STRINGS "${inventory}" previous ENCODING UTF-8)
    set(stale ${previous})
    list(REMOVE_ITEM stale ${current})
    list(REVERSE stale) # children before parent directories
    foreach(relative IN LISTS stale)
        if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.(/|$)" OR relative MATCHES "[:\\\\]")
            message(FATAL_ERROR "Invalid scene data inventory path: ${relative}")
        endif()
        set(old "${destination}/${relative}")
        file(REAL_PATH "${old}" resolved)
        cmake_path(IS_PREFIX destination "${resolved}" NORMALIZE inside_destination)
        if(NOT inside_destination OR resolved STREQUAL destination)
            message(FATAL_ERROR "Refusing to remove a path outside the staged game: ${old}")
        endif()
        if(IS_DIRECTORY "${old}" AND NOT IS_SYMLINK "${old}")
            file(GLOB remaining "${old}/*")
            if(NOT remaining)
                file(REMOVE_RECURSE "${old}")
            endif()
        else()
            file(REMOVE "${old}")
        endif()
    endforeach()
else()
    file(GLOB unrelated "${destination}/*")
    if(unrelated)
        message(FATAL_ERROR "Scene data destination is not empty or managed by this build: ${destination}. Choose a clean output folder.")
    endif()
endif()
foreach(relative IN LISTS current)
    set(source "${project_root}/${relative}")
    set(target "${destination}/${relative}")
    if(IS_SYMLINK "${target}")
        file(REMOVE "${target}")
    endif()
    if(IS_DIRECTORY "${source}")
        if(EXISTS "${target}" AND NOT IS_DIRECTORY "${target}")
            file(REMOVE "${target}")
        endif()
        file(MAKE_DIRECTORY "${target}")
    else()
        if(IS_DIRECTORY "${target}")
            message(FATAL_ERROR "A directory blocks the staged file: ${target}")
        endif()
        file(COPY_FILE "${source}" "${target}" ONLY_IF_DIFFERENT)
    endif()
endforeach()
string(REPLACE ";" "\n" inventory_text "${current}")
file(WRITE "${inventory}" "${inventory_text}\n")
